+    // The OCaml Eio harness owns terminal modes and cleanup, so it needs the
+    // reference capability-probe phase without setupTerminal's alternate
+    // screen and feature-enable side effects. Keep the probe construction in
+    // native code so multiplexer wrapping, XTVERSION ordering, and pending
+    // retries remain the reference implementation's responsibility.
+    pub fn queryTerminalCapabilities(self: *CliRenderer) void {
+        var queryBuf: [4096]u8 = undefined;
+        var writer: std.Io.Writer = .fixed(&queryBuf);
+        self.terminal.queryTerminalSend(&writer) catch {
+            logger.warn("Failed to query terminal capabilities", .{});
+        };
+        self.backend.writeOut(writer.buffered());
+        self.queryPixelResolution();
+    }
